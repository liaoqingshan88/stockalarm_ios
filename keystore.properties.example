# Copy to keystore.properties (do not commit keystore.properties) and fill in your release keystore.
# Paths for storeFile are relative to the app/ module unless you use an absolute path.
#
# Example when keystore sits in project root:
# storeFile=../my-release.jks
#
keyAlias=your_key_alias
keyPassword=your_key_password
storePassword=your_store_password
storeFile=../path/to/your-release.jks
// Optional: jks or pkcs12
storeType=jks
