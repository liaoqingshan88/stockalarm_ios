        Notification notice = new Notification( R.drawable.ic_launcher,
        		app_name,
        		System.currentTimeMillis());
        
        notice.flags=Notification.FLAG_AUTO_CANCEL;
        Intent appIntent = new Intent(Intent.ACTION_MAIN);
     
        appIntent.addCategory(Intent.CATEGORY_LAUNCHER);
        appIntent.setComponent(new ComponentName(this.getPackageName(), this.getPackageName() + "." + this.getLocalClassName())); 
        appIntent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK| Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);//关键的一步，设置启动模式为打开上一个activity
        PendingIntent contentIntent =PendingIntent.getActivity(this, 0,appIntent,0);
        notice.setLatestEventInfo(this, app_name ,msg, contentIntent);
        //#if 0
        //notice.sound = Uri.withAppendedPath(Audio.Media.INTERNAL_CONTENT_URI, "1");
        //#else   //modi to default ring. ipdiy 2015.3.17 . because Audio.Media.INTERNAL_CONTENT_URI no round at xiaomi3.
        notice.defaults |= Notification.DEFAULT_SOUND;
        //#endif
        notice.defaults |= Notification.DEFAULT_VIBRATE;
        barmanager.notify(0,notice);
		
	}

	void DisableItems(List<StockMng> list_stock) {
		ListView list = (ListView) findViewById(R.id.ListView01);

		if( list.getChildCount() == 0) {
			return;
		}

		//final EditText e_info = (EditText) findViewById(R.id.edit_stock_info) ;
		for(int i=0; i<list_stock.size(); i++) {
			StockMng stock = list_stock.get(i);

			if(! stock.IsValid()) {
				list.getChildAt(i).setBackgroundColor(Color.GRAY);
				//setTitle("-"+stock.GetName());
			}
			else {
				list.getChildAt(i).setBackgroundColor(Color.BLACK);
				//setTitle("+"+stock.GetName());
			}
		}
	}

	void createListView(List<StockMng> list_stock) {
		//绑定Layout里面的ListView
		ListView list = (ListView) findViewById(R.id.ListView01);
		//生成动态数组，加入数据
		ArrayList<HashMap<String, Object>> listItem = new ArrayList<HashMap<String, Object>>();
		if( list_stock.size() == 0)//add 2013.5.21
		{
			return ;
		}

		for(int i=0; i<list_stock.size(); i++) {
			StockMng stock = list_stock.get(i);
			HashMap<String, Object> map = new HashMap<String, Object>();
			//map.put("ItemImage", R.drawable.ic_launcher);//图像资源的ID
			map.put("code", stock.GetCode());
			map.put("name", stock.GetName());
			//map.put("price", stock.GetPrice());
			map.put("high", stock.GetHigh().toString());
			map.put("low", stock.GetLow().toString());
			map.put("rise", stock.GetRise());
			map.put("drop", stock.GetDrop());
			listItem.add(map);
		}

		//*
		//生成适配器的Item和动态数组对应的元素
		SimpleAdapter listItemAdapter = new SimpleAdapter(
			this,
			listItem,//数据源
			R.layout.list_items,//ListItem的XML实现
			//动态数组与ImageItem对应的子项
			new String[] {"code", "name", "price", "high","low","rise", "drop"},
			//ImageItem的XML文件里面的一个ImageView,两个TextView ID
			new int[] {0, R.id.list_name, R.id.list_price_now,
					   R.id.list_high, R.id.list_low, R.id.list_rise, R.id.list_drop
					  }
		);
		//添加并且显示
		list.setAdapter(listItemAdapter);
		//list.getItemAtPosition(0).ForceColor = Color.RED;
		// list.Items[0].ForeColor = Color.RED;
		// list.Items[0].UseItemStyleForSubItems = false;
		// list.selectedItems.BackColor = Color.RED;
		//*/
		//添加点击
		list.setOnItemClickListener(new OnItemClickListener() {
			@Override
			public void onItemClick(AdapterView<?> arg0, View arg1, int arg2,
			long arg3) {
				Map <String,Object> map = extracted(arg2);
				String code = map.get("code").toString();
				final EditText e_code = (EditText) findViewById(R.id.edit_stock_code) ;
				e_code.setText(code);

				try {
					//查询数据库
					StockMng stockMng = new StockMng(mySqlite);
					stockMng.Get(code);
					final EditText e_price_h = (EditText) findViewById(R.id.edit_price_h) ;
					final EditText e_price_l = (EditText) findViewById(R.id.edit_price_l) ;
					final EditText e_rise = (EditText) findViewById(R.id.edit_rise) ;
					final EditText e_drop = (EditText) findViewById(R.id.edit_drop) ;
					e_price_h.setText(stockMng.GetHigh().toString());
					e_price_l.setText(stockMng.GetLow().toString());
					e_rise.setText(""+stockMng.GetRise());
					e_drop.setText(""+stockMng.GetDrop());
					final Button btn_Add=(Button)findViewById(R.id.btn_submit);
					btn_Add.setText("更新预警");
				}
				catch (Exception e) {
				}
			}
		});
		//list.getItemAtPosition(0).
		//添加长按点击
		list.setOnCreateContextMenuListener(new OnCreateContextMenuListener() {
			@Override
			public void onCreateContextMenu(ContextMenu menu, View v,ContextMenuInfo menuInfo) {
				menu.setHeaderTitle("股票更改");
				//ListView list = (ListView) findViewById(R.id.ListView01);
				menu.add(1, 0, 4, "删除这支股票预警");

				try {
					AdapterView.AdapterContextMenuInfo info = (AdapterView.AdapterContextMenuInfo)menuInfo;
					int stock_id = (int)info.id;//这里的info.id对应的就是数据库中_id的值
					Map <String,Object> map = extracted(stock_id);
					String code = map.get("code").toString();
					StockMng stockMng = new StockMng(mySqlite);
					stockMng.Get(code);

					if( stockMng.IsValid()) {
						menu.add(2, 1, 5, "暂停这支股票预警");
					}
					else {
						menu.add(2, 1, 5, "激活这支股票预警");
					}
				}
				catch (Exception e) {
				}
			}
		});
	}

	//长按菜单响应函数
	@Override
	public boolean onContextItemSelected(MenuItem item) {
		AdapterView.AdapterContextMenuInfo info = (AdapterView.AdapterContextMenuInfo)item.getMenuInfo();
		int stock_id = (int)info.id;//这里的info.id对应的就是数据库中_id的值
		//info.toString();
		Map <String,Object> map = extracted(stock_id);
		String code = map.get("code").toString();
		StockMng stockMng = new StockMng(mySqlite);

		switch( item.getItemId()) {
			case 0:
				stockMng.Delete(code);
				createListView(m_stockMng.getStocks());
				DisableItems(m_stockMng.getStocks());
				break;

				//
			case 1:
				try {
					stockMng.Get(code);

					if( stockMng.IsValid()) {
						stockMng.Enable(false);
					}
					else {
						stockMng.Enable(true);
					}

					stockMng.Update();
					DisableItems(m_stockMng.getStocks());
				}
				catch(Exception e) {
					setTitle(getTitle() + "diable + " + e.toString());
				}

				break;
		}

		return super.onContextItemSelected(item);
	}


	
	public static void ReflashStockPrice(ListView lv, List<SinaStockInfo> stockinfos) {
		// TODO Auto-generated method stub
		//RelativeLayout lr = (RelativeLayout) findViewById(R.id.RelativeLayout01);
		//TextView mText1 = (TextView)lr.getChildAt(1);
		//int id2 = mText1.getId();
		//获取下一行的index
		//int index = listview.getSelectedItemPosition() + 1;
		//获取下一行的TextViewstockinfos.size()
		if( null == lv || null == stockinfos )
		{
			Log.e("reflash", "ReflashStockPrice para err");
			return ;
		}
		

		for( int i = 0, j =0; i<lv.getCount()&&j < stockinfos.size() ; i++) {
			View group = lv.getChildAt(i);
            if( null == group )
            {
                Log.d("reflash", "stock count more than view");
                break;  //add by ipdiy. 205.4.8 .. ????е??п??????????????
            }
			// int id = group.getId();
			RelativeLayout lr2 = (RelativeLayout)group;
			TextView NameText = (TextView)lr2.getChildAt(0);
			String name = NameText.getText().toString();
			TextView priceText = (TextView)lr2.getChildAt(1);
			//StockMng stock = new StockMng(mySqlite);
			//String code = codeText.getText().toString();
			//stock.Get(code);
			SinaStockInfo stock1 = stockinfos.get(j);

			if( stock1.getName().equals(name)) {
				//TextView mText = (TextView)listview.getChildAt(i).get;
				//获取一下行的值
				//String value = tv.getText().toString();
				String price = ""+stock1.getNowPrice();
				priceText.setText(price);
				j++;
			}
		}
	}	

	
	private HashMap<String, Object> extracted(int position) {
		ListView list=(ListView)findViewById(R.id.ListView01);
		return (HashMap<String,Object>)(list.getAdapter().getItem(position));
	}
	
}


