<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="【系统设置】"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- 多端同步账号入口 -->
    <Button
        android:id="@+id/btn_sync_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="多端同步账号（登录/注册）"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:layout_marginBottom="8dp" />

    <!-- 版本信息 -->
    <TextView
        android:id="@+id/text_version"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="当前版本："
        android:textSize="13sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- 振动设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="启用振动"
            android:textSize="16sp"
            android:textColor="#000000" />

        <CheckBox
            android:id="@+id/check_vibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 铃声设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通知铃声"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/text_ringtone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认铃声"
                    android:textSize="14sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_select_ringtone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择铃声"
                android:textSize="14sp"
                android:textColor="#000000"
                android:background="#FFFFFF"
                android:minWidth="80dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 列表颜色设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="股票列表颜色"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/group_color_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_colorful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="彩色"
                android:textColor="#FF0000"
                android:layout_marginRight="16dp" />

            <RadioButton
                android:id="@+id/radio_bw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="黑白"
                android:textColor="#000000" />
        </RadioGroup>
    </LinearLayout>

    <!-- 均线预警设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="均线预警设置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择股票"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="2dp" />

        <Spinner
            android:id="@+id/spinner_ma_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- 7 条均线：MA5/MA10/MA20/MA30/MA60/MA120/MA250 -->
        <LinearLayout
            android:id="@+id/ma_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA5"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_5"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA10"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_10"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA20"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_20"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA30"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_30"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA60"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_60"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA120"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_120"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_120"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_120"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_120"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ma_row_250"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MA250"
                android:textSize="14sp"
                android:textColor="#000000" />
            <RadioGroup
                android:id="@+id/ma_radio_group_250"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/ma_radio_on_250"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启"
                    android:textSize="13sp"
                    android:textColor="#000000" />
                <RadioButton
                    android:id="@+id/ma_radio_off_250"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginLeft="8dp" />
            </RadioGroup>
            <EditText
                android:id="@+id/ma_edit_250"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:hint="价格"
                android:textSize="14sp"
                android:textColor="#000000"
                android:textColorHint="#999999"
                android:background="#FFFFFF"
                android:padding="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save_ma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存均线设置"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 软件修改意见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="4dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="软件修改意见"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:gravity="top|start"
            android:inputType="textLongMessage|textMultiLine"
            android:hint="请输入您希望修改或新增的功能"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btn_submit_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提交意见"
            android:textSize="14sp"
            android:textColor="#000000"
            android:background="#FFFFFF" />

        <!-- 状态显示区域 -->
        <TextView
            android:id="@+id/text_submit_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:background="#E8F5E9"
            android:visibility="gone"
            android:minHeight="80dp"
            android:maxHeight="150dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- 返回按钮 -->
    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="返回"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:background="#FFFFFF"
        android:layout_marginTop="16dp" />

</LinearLayout>
